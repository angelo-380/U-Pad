# Puerto del servidor Express y entorno
PORT=3000
NODE_ENV=development

# Configuración JWT (Firma simétrica HMAC-SHA256)
JWT_SECRET=tu_clave_secreta_super_segura_de_al_menos_32_caracteres
JWT_EXPIRES_IN=24h

# Configuración Firebase Cloud / Emulador Local
FIREBASE_PROJECT_ID=upad-dev-project

# Si está activo, el SDK de Firebase Admin se conecta al emulador local en lugar de la nube
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Orígenes CORS permitidos (separados por coma si son varios)
CORS_ORIGIN=http://localhost:5173

# ==============================================================================
# CONFIGURACIÓN DEL ADMINISTRADOR INICIAL (scripts/seedAdmin.js)
# ==============================================================================
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=tu_contrasena_de_administrador_segura
ADMIN_NAME=Administrador U-Pad

# ==============================================================================
# CONFIGURACIÓN DE RATE LIMITING (express-rate-limit)
# ==============================================================================
# Ventana de tiempo en minutos para el conteo de peticiones (defecto: 15)
RATE_LIMIT_WINDOW_MIN=15

# Máximo de peticiones permitidas en la ventana para toda la API (defecto: 100)
# Para pruebas de carga masivas con k6/Artillery locales, cambiar temporalmente a 100000
RATE_LIMIT_MAX=100000

# Máximo de intentos permitidos en endpoints críticos de auth (login/register) contra fuerza bruta (defecto: 10)
RATE_LIMIT_AUTH_MAX=10
