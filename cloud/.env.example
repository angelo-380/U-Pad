# ==============================================================================
# U-PAD GOOGLE CLOUD ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

NODE_ENV=development
PORT=8080
HOST=0.0.0.0

GCP_PROJECT_ID=your-gcp-project-id
GCP_PROJECT_NUMBER=your-gcp-project-number
GCP_REGION=us-central1

DB_PATH=./upad_relational.db
DB_POOL_MAX_CLIENTS=100

GCP_KMS_KEY_RING=upad-keyring-prod
GCP_KMS_CRYPTO_KEY=upad-master-pepper-key
GCP_KMS_PEPPER_SECRET=example_secret_pepper_key
JWT_SECRET_KEY=example_jwt_secret_token

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
DEBOUNCE_COOLDOWN_MS=1200

LOG_LEVEL=INFO
GCP_LOGGING_ENABLED=true
