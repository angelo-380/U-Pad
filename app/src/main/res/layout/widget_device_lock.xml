<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_lock_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_widget_session"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tv_widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="BLOQUEO REMOTO"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#01579B" />

        <ImageView
            android:id="@+id/btn_refresh_lock_widget"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_popup_sync"
            android:tint="#616161"
            android:contentDescription="Refrescar"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE"
        android:importantForAccessibility="no"
        android:layout_marginBottom="12dp" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/tv_empty_devices"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="Sin dispositivos vinculados.\nEnlaza uno en la app."
        android:textColor="#888888"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Device 1 Layout -->
    <RelativeLayout
        android:id="@+id/layout_device_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:padding="6dp"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/btn_device_1_action"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tv_device_1_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tablet Niño"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1E1E1E"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_device_1_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estado: LIBRE 🔓"
                android:textSize="11sp"
                android:textColor="#43A047"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_device_1_action"
            android:layout_width="90dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/widget_btn_lock_bg"
            android:text="BLOQUEAR"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />
    </RelativeLayout>

    <!-- Device 2 Layout -->
    <RelativeLayout
        android:id="@+id/layout_device_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="6dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/btn_device_2_action"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tv_device_2_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Celular Niño"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1E1E1E"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_device_2_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estado: LIBRE 🔓"
                android:textSize="11sp"
                android:textColor="#43A047"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_device_2_action"
            android:layout_width="90dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/widget_btn_lock_bg"
            android:text="BLOQUEAR"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />
    </RelativeLayout>

</LinearLayout>
